<cover-view class="tabbar-wrap">
  <cover-view class="tabbar">
    <cover-view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tab-item"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <cover-view class="tab-text {{selected === index ? 'tab-text-active' : ''}}">{{item.text}}</cover-view>
    </cover-view>
  </cover-view>
</cover-view>
